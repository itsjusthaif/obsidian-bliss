{
  "name": "bliss-obsidian-theme",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "description": "Test tooling for the Bliss Obsidian theme.",
  "scripts": {
    "lint": "node tests/lint.mjs",
    "perf": "node tests/perf.mjs",
    "perf:live": "node tests/perf-live.mjs",
    "parity": "node tests/parity.mjs",
    "selectors": "node tests/selectors.mjs",
    "release-check": "node tests/release-check.mjs",
    "live": "node tests/live.mjs",
    "visual": "node tests/visual.mjs",
    "visual:update": "node tests/visual.mjs --update",
    "test": "node tests/lint.mjs && node tests/perf.mjs && node tests/regression.mjs",
    "regression": "node tests/regression.mjs",
    "setup": "git config core.hooksPath .githooks",
    "task": "node tests/task.mjs",
    "ship": "node tests/ship.mjs",
    "test:live": "node tests/live.mjs && node tests/visual.mjs"
  }
}
